# ═══════════════════════════════════════════════════════════════════════════════
# SwarmIDE2 Environment Configuration
# Copy this file to .env.local and fill in your API keys
# ═══════════════════════════════════════════════════════════════════════════════

# ─────────────────────────────────────────────────────────────────────────────────
# LLM PROVIDERS
# ─────────────────────────────────────────────────────────────────────────────────

# Google Gemini (Primary)
GOOGLE_API_KEY=your-google-api-key-here
API_KEY=your-google-api-key-here
GEMINI_MODEL=gemini-2.0-flash

# OpenAI (GPT-4o)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Anthropic Claude
CLAUDE_API_KEY=your-claude-api-key-here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Groq (Fast inference)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=mixtral-8x7b-32768

# Mistral
MISTRAL_API_KEY=your-mistral-api-key-here
MISTRAL_MODEL=mistral-large-latest

# Perplexity (Web-grounded)
PERPLEXITY_API_KEY=your-perplexity-api-key-here
PERPLEXITY_MODEL=pplx-7b-online

# DeepSeek
DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# ─────────────────────────────────────────────────────────────────────────────────
# OBSERVABILITY & TRACING
# ─────────────────────────────────────────────────────────────────────────────────

# Langfuse (LLM tracing & cost tracking)
LANGFUSE_PUBLIC_KEY=pk_your-public-key-here
LANGFUSE_SECRET_KEY=sk_your-secret-key-here
LANGFUSE_URL=https://cloud.langfuse.com

# ─────────────────────────────────────────────────────────────────────────────────
# EXTERNAL WORKFLOW EXECUTION
# ─────────────────────────────────────────────────────────────────────────────────

# n8n (Workflow automation)
N8N_BASE_URL=http://localhost:5678
N8N_API_KEY=your-n8n-api-key-here

# Langflow (Visual orchestration)
LANGFLOW_BASE_URL=http://localhost:7860
LANGFLOW_API_KEY=your-langflow-api-key-here

# ─────────────────────────────────────────────────────────────────────────────────
# PERSISTENCE & STORAGE
# ─────────────────────────────────────────────────────────────────────────────────

# Supabase (Cloud database)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# ─────────────────────────────────────────────────────────────────────────────────
# VECTOR DATABASES
# ─────────────────────────────────────────────────────────────────────────────────

# Qdrant (Vector DB)
QDRANT_URL=http://localhost:6333
VECTOR_DB_API_KEY=your-qdrant-api-key-here
QDRANT_COLLECTION_NAME=swarmide2

# Milvus (Alternative vector DB)
MILVUS_URL=http://localhost:19530

# Pinecone (Serverless vector DB)
PINECONE_API_KEY=your-pinecone-api-key-here
PINECONE_ENVIRONMENT=your-pinecone-environment
PINECONE_INDEX_NAME=swarmide2

# ─────────────────────────────────────────────────────────────────────────────────
# LOCAL MODELS (Offline Mode)
# ─────────────────────────────────────────────────────────────────────────────────

# Ollama (Local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama2

# ─────────────────────────────────────────────────────────────────────────────────
# APP CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────────

# Default provider (gemini, openai, claude, groq, mistral, perplexity, deepseek, ollama)
DEFAULT_PROVIDER=gemini

# Default model
DEFAULT_MODEL=gemini-2.0-flash

# Enable/disable integrations
ENABLE_LANGFUSE=true
ENABLE_N8N=false
ENABLE_LANGFLOW=false
ENABLE_SUPABASE=false
ENABLE_OLLAMA=false

# Cost limits
MAX_DAILY_COST_USD=100
MAX_PROJECT_COST_USD=50

# ═══════════════════════════════════════════════════════════════════════════════
# GETTING API KEYS
# ═══════════════════════════════════════════════════════════════════════════════

# Google Gemini:    https://makersuite.google.com/app/apikey
# OpenAI:           https://platform.openai.com/api-keys
# Claude:           https://console.anthropic.com/
# Groq:             https://console.groq.com/
# Mistral:          https://console.mistral.ai/
# Perplexity:       https://www.perplexity.ai/api
# DeepSeek:         https://platform.deepseek.com/
# Langfuse:         https://cloud.langfuse.com/
# n8n:              https://n8n.io/ (self-hosted)
# Langflow:         https://www.langflow.org/ (self-hosted)
# Supabase:         https://supabase.com/
# Qdrant:           https://qdrant.tech/ (self-hosted or cloud)
# Pinecone:         https://www.pinecone.io/
# Ollama:           https://ollama.ai/ (self-hosted)

# ═══════════════════════════════════════════════════════════════════════════════
# QUICK START
# ═══════════════════════════════════════════════════════════════════════════════

# Minimum required (free tier):
#   1. Get GOOGLE_API_KEY from https://makersuite.google.com/app/apikey
#   2. Rename this file to .env.local
#   3. Fill in GOOGLE_API_KEY
#   4. Run: npm install && npm run dev

# Production ready (recommended):
#   1. Add all provider API keys
#   2. Set up Supabase account for persistence
#   3. Configure Qdrant for vector search
#   4. Enable Langfuse for observability
#   5. Deploy with Docker/Kubernetes
